    {
      "parameters": {
        "jsCode": "\nconst assignment = $input.first().json;\n\nconst facilitators = $(\"DEV — Team Members DB\").all()\n  .map(item => item.json);\n\nconst sessions = $(\"DEV — Event Instances DB\").all()\n  .map(item => item.json);\n\nconst facilitatorRef = assignment.property_facilitator?.[0];\nconst sessionRef = assignment.property_event_instance?.[0];\n\nconst facilitator = facilitators.find(\n  person => person.id === facilitatorRef\n);\n\nconst session = sessions.find(\n  event => event.id === sessionRef\n);\n\nif (!facilitator || !session) {\n  throw new Error(\n    \"Unable to resolve DEV facilitator or session relation\"\n  );\n}\n\nconst facilitatorId =\n  facilitator.property_facilitator_external_id;\n\nconst sessionId =\n  session.property_session_external_id;\n\nif (!/^BR-F-\\d{6}$/.test(facilitatorId) ||\n    !/^BR-S-\\d{6}$/.test(sessionId)) {\n  throw new Error(\"Missing or invalid portable ID\");\n}\n\n\nconst counterRows = $(\"DEV — Read Assignment ID Counter\").all();\n\nif (counterRows.length !== 1) {\n  throw new Error(\"Expected exactly one Assignment ID counter row\");\n}\n\nconst counter = counterRows[0].json;\n\nif (counter[\"Entity Type\"] !== \"Assignment\") {\n  throw new Error(\"Incorrect ID counter entity\");\n}\n\nconst nextNumber = Number(counter[\"Next Number\"]);\nconst width = Number(counter[\"Width\"]);\nconst prefix = counter[\"Prefix\"];\n\nif (!Number.isSafeInteger(nextNumber) || nextNumber < 1 ||\n    !Number.isSafeInteger(width) || width < 1 ||\n    prefix !== \"BR-A-\") {\n  throw new Error(\"Invalid Assignment ID counter configuration\");\n}\n\nconst proposedAssignmentId =\n  prefix + String(nextNumber).padStart(width, \"0\");\n\n\nconst googleRows = $(\"DEV VERSION Bible Facilitation Roster\")\n  .all()\n  .map(item => item.json);\n\n// Ignore blank rows, including the row containing\n// the existing facilitator-name formula.\nconst existingAssignments = googleRows.filter(\n  row => String(row[\"Assignment ID\"] ?? \"\").trim() !== \"\"\n);\n\n\nconst matchingNotionPage = existingAssignments.find(\n  row => String(row[\"Notion Assignment Page ID\"] ?? \"\")\n    .replace(/-/g, \"\").toLowerCase() ===\n    String(assignment.id).replace(/-/g, \"\").toLowerCase()\n);\n\n\nconst existingAssignmentId = matchingNotionPage\n  ? String(matchingNotionPage[\"Assignment ID\"]).trim()\n  : null;\n\n\nconst duplicate = existingAssignments.find(\n  row => String(row[\"Assignment ID\"]).trim() === proposedAssignmentId\n);\n\nif (duplicate) {\n  throw new Error(\n    `Assignment ID ${proposedAssignmentId} already exists in Google`\n  );\n}\n\nconst duplicateCheck = \"PASS — ID not found in Google\";\n\nreturn [{\n  json: {\n    notionAssignmentPageId: assignment.id,\n    facilitatorId,\n    sessionId,\n    role: assignment.property_role,\n    assignmentType: assignment.property_assignment_type,\n    confirmation: assignment.property_confirmation,\n    assignmentState: assignment.property_assignment_state,\n    facilitatorName: facilitator.name,\n    duplicateCheck,\n    proposedAssignmentId\n  }\n}];\n"
      },
