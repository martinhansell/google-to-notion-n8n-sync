    {
      "parameters": {
        "jsCode": "const changes = $input.all();\n\nconst sessionDates = changes\n  .map(item => item.json)\n  .filter(r =>\n    r.Entity === \"Session\" &&\n    r.Field === \"Date\" &&\n    r.Origin === \"Google\" &&\n    /^BR-S-\\d{6}$/.test(String(r[\"External ID\"] ?? \"\")) &&\n    /^\\d{4}-\\d{2}-\\d{2}$/.test(String(r[\"New Value\"] ?? \"\")) &&\n    !Number.isNaN(Date.parse(r[\"Changed At\"]))\n  )\n  .sort((a, b) =>\n    Date.parse(b[\"Changed At\"]) -\n    Date.parse(a[\"Changed At\"]) ||\n    Number(b.row_number) - Number(a.row_number)\n  );\n\nconst latestBySession = new Map();\n\nfor (const change of sessionDates) {\n  const id = change[\"External ID\"];\n\n  if (!latestBySession.has(id)) {\n    latestBySession.set(id, {\n      sessionId: id,\n      field: \"Date\",\n      proposedValue: change[\"New Value\"],\n      changedAt: change[\"Changed At\"],\n      origin: \"Google\",\n      logRow: change.row_number\n    });\n  }\n}\n\nreturn [...latestBySession.values()]\n  .map(record => ({ json: record }));\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        624,
        304
