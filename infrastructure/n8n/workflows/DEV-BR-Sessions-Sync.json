    {
      "parameters": {
        "jsCode": "\nconst items = $input.all().map(i => i.json);\n\n// Existing session comparisons\nconst comparisons = items.filter(r =>\n  r.sessionId &&\n  r.notionPageId &&\n  Array.isArray(r.differences)\n);\n\n// Google edit records\nconst edits = items.filter(r =>\n  r.sessionId &&\n  r.field === \"Date\" &&\n  r.origin === \"Google\" &&\n  r.changedAt\n);\n\nconst latestEditById = new Map();\n\nfor (const edit of edits) {\n  const previous = latestEditById.get(edit.sessionId);\n\n  if (!previous ||\n      Date.parse(edit.changedAt) >\n      Date.parse(previous.changedAt)) {\n    latestEditById.set(edit.sessionId, edit);\n  }\n}\n\nconst results = [];\n\nfor (const session of comparisons) {\n  const difference = session.differences.find(\n    d => d.field === \"Date\"\n  );\n\n  if (!difference) continue;\n\n  const googleEdit = latestEditById.get(\n    session.sessionId\n  );\n\n  const matchesLoggedEdit = Boolean(\n    googleEdit &&\n    googleEdit.proposedValue === difference.google\n  );\n\n  results.push({\n    json: {\n      sessionId: session.sessionId,\n      notionPageId: session.notionPageId,\n      googleDate: difference.google,\n      notionDate: difference.notion,\n      googleChangedAt: googleEdit?.changedAt ?? null,\n      googleLogRow: googleEdit?.logRow ?? null,\n      matchesLoggedEdit,\n      decision: !session.valid\n        ? \"REVIEW\"\n        : matchesLoggedEdit\n          ? \"GOOGLE_CHANGE_IDENTIFIED\"\n          : \"ORIGIN_UNRESOLVED\",\n      safeToWrite: false\n    }\n  });\n}\n\nreturn results;\n"
      },
