    {
      "parameters": {
        "jsCode": "\n/**\n * DEV — Prepare Google Events\n *\n * Converts SyncChangeLog entries into\n * PostgreSQL-ready event records.\n *\n * No writes or synchronisation decisions.\n */\n\nconst rows = $input.all();\n\nconst ENTITIES = new Set([\n  \"Session\",\n  \"Assignment\",\n  \"Facilitator\"\n]);\n\nreturn rows.map(item => {\n  const r = item.json;\n\n  const eventId = String(r[\"Event ID\"] ?? \"\").trim();\n  const entityType = String(r.Entity ?? \"\").trim();\n  const externalId = String(r[\"External ID\"] ?? \"\").trim();\n  const field = String(r.Field ?? \"\").trim();\n  const changedAt = String(r[\"Changed At\"] ?? \"\").trim();\n\n  const valid = Boolean(\n    /^[0-9a-f]{8}-[0-9a-f-]{27,}$/i.test(eventId) &&\n    ENTITIES.has(entityType) &&\n    /^BR-[SAF]-\\d{6}$/.test(externalId) &&\n    field &&\n    changedAt &&\n    !Number.isNaN(Date.parse(changedAt))\n  );\n\n  return {\n    json: {\n      eventKey: eventId,\n      origin: \"Google\",\n      entityType,\n      externalId,\n      notionPageId: null,\n      changedAt,\n\n      changedFields: [{\n        field,\n        newValue: r[\"New Value\"] ?? null,\n        previousValue: r[\"Previous Value\"] ?? null\n      }],\n\n      sourceRow: r.row_number,\n      sourceCell: r.Cell ?? null,\n\n      valid,\n      status: \"REVIEW\",\n      safeToWrite: false\n    }\n  };\n});\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        640,
        720
      ],
      "id": "03a3ac70-b216-451b-9146-6d59371d6bbc",
      "name": "DEV — Prepare Google Events"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "\nINSERT INTO sync_events (\n    event_key,\n    origin,\n    entity_type,\n    external_id,\n    notion_page_id,\n    changed_at,\n    changed_fields,\n    event_payload,\n    status\n)\nVALUES (\n    $1,\n    'Google',\n    $2,\n    $3,\n    NULL,\n    $4::timestamptz,\n    $5::jsonb,\n    $6::jsonb,\n    'REVIEW'\n)\nON CONFLICT (event_key) DO NOTHING\nRETURNING id, event_key, external_id, status;\n",
        "options": {
          "queryReplacement": "= {{ [   $json.eventKey,   $json.entityType,   $json.externalId,   $json.changedAt,   JSON.stringify($json.changedFields),   JSON.stringify($json) ] }}"
        }
      },
