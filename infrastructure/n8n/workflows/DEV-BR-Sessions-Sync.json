    {
      "parameters": {
        "jsCode": "const records = $input.all();\n\nfunction clean(value) {\n  return String(value ?? \"\").trim();\n}\n\nfunction dateOnly(value) {\n  if (!value) return \"\";\n  return clean(value).slice(0, 10);\n}\n\nreturn records.map(item => {\n  const r = item.json;\n  const sessionId = clean(r[\"Session ID\"]);\n  const eventDate = dateOnly(r.property_event_date?.start);\n\n  // DEV record titles:\n  // \"Reading Unit · Location · YYYY-MM-DD\"\n  const title = clean(r.property_event_instance || r.name);\n  const parts = title.split(\" · \");\n\n  const notionUnit = clean(\n    r.property_programme_item_name_helper?.[0] ||\n    (parts.length === 3 ? parts[0] : \"\")\n  );\n\n  const notionLocation = clean(\n    r.property_team_location_name_helper?.[0] ||\n    (parts.length === 3 ? parts[1] : \"\")\n  );\n\n  const fields = [\n    [\"Date\", dateOnly(r.Date), eventDate],\n    [\"Location\", clean(r.Location), notionLocation],\n    [\"Reading Unit\", clean(r[\"Reading Unit\"]), notionUnit],\n    [\"Session Status\",\n      clean(r[\"Session Status\"]),\n      clean(r.property_instance_status)]\n  ];\n\n  const differences = fields\n    .filter(([field, google, notion]) => google !== notion)\n    .map(([field, google, notion]) => ({\n      field, google, notion\n    }));\n\n  const valid = Boolean(\n    sessionId &&\n    sessionId === clean(r.property_session_external_id) &&\n    eventDate &&\n    notionUnit &&\n    notionLocation\n  );\n\n  return {\n    json: {\n      sessionId,\n      notionPageId: r.id,\n      valid,\n      result: !valid\n        ? \"REVIEW\"\n        : differences.length\n          ? \"DIFFERENT\"\n          : \"MATCH\",\n      differenceCount: differences.length,\n      differences\n    }\n  };\n});"
      },
